# Copy to .env. Use a long URL-safe database password (letters, digits, - and _ only).
POSTGRES_DB=vignan_presence
POSTGRES_USER=vignan_presence
POSTGRES_PASSWORD=replace-with-a-random-url-safe-secret
PUBLIC_BASE_URL=https://presence.example.edu
PORT=8000
# Required only for first production administrator setup; remove after setup is complete.
SETUP_BOOTSTRAP_TOKEN=replace-with-a-separate-one-time-random-token
SESSION_HOURS=10
PRESENCE_RETENTION_DAYS=30
LOCATION_ACCURACY_LIMIT_M=120
# Optional browser Maps JavaScript API key. Restrict it by website and API in Google Cloud.
GOOGLE_MAPS_API_KEY=
